eStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;rounded=0;" edge="1" parent="1" source="r_panier_items_panier_items_variante_id" target="r_variantes_variante_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;rounded=0;" edge="1" parent="1" source="r_commandes_commande_user_id" target="r_users_user_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;rounded=0;" edge="1" parent="1" source="r_commandes_commande_adress_id" target="r_adress_adress_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;rounded=0;" edge="1" parent="1" source="r_commandes_items_commande_id" target="r_commandes_commande_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;rounded=0;" edge="1" parent="1" source="r_commandes_items_commande_variante_id" target="r_variantes_variante_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;rounded=0;" edge="1" parent="1" source="r_user_guest_commande_id" target="r_commandes_commande_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;rounded=0;" edge="1" parent="1" source="r_commandes_userguest_commande_id" target="r_commandes_commande_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;rounded=0;" edge="1" parent="1" source="r_commandes_userguest_user_guest_id" target="r_user_guest_user_guest_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;rounded=0;" edge="1" parent="1" source="r_promotion_promotion_category_id" target="r_categorie_category_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;rounded=0;" edge="1" parent="1" source="r_promotion_promotion_product_id" target="r_product_product_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;rounded=0;" edge="1" parent="1" source="r_reduction_promotion_id" target="r_promotion_promotion_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Schéma corrigé — aucune table ni colonne renommée&lt;/b&gt;&lt;br&gt;&lt;font color='#82b366'&gt;■&lt;/font&gt; colonne ajoutée &amp;nbsp; &lt;font color='#d79b00'&gt;■&lt;/font&gt; colonne corrigée (type / FK / contrainte) &amp;nbsp; □ inchangée&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; clé primaire · &lt;b&gt;FK&lt;/b&gt; clé étrangère · &lt;b&gt;UQ&lt;/b&gt; unique · &lt;b&gt;?&lt;/b&gt; nullable&lt;br&gt;&lt;br&gt;&lt;b&gt;Corrections transverses&lt;/b&gt;&lt;br&gt;• Dates stockées en String / « DataTime » → &lt;i&gt;timestamptz&lt;/i&gt; (défaut now())&lt;br&gt;• Colonnes sans type (prix) → &lt;i&gt;numeric(12,2)&lt;/i&gt;, quantités → integer CHECK &amp;gt; 0&lt;br&gt;• FK manquantes ajoutées (panier, commandes, items, promotion, marque, catégorie…)&lt;br&gt;• Pivots (Product_Pivot, Category_Pivot) : clé primaire composite + ON DELETE CASCADE&lt;br&gt;• Arête orpheline « One to Many et Many to One » : relie MARQUES → PRODUCT&lt;br&gt;• Product_Pivot interprété comme &lt;b&gt;favoris&lt;/b&gt; (utilisateur ↔ produit)&lt;br&gt;• Typos « adress_contry », « Stri,g », « DataTime » : noms de colonnes conservés&lt;br&gt;&lt;br&gt;&lt;b&gt;Cohérence automatique (triggers)&lt;/b&gt;&lt;br&gt;• variantes.variante_price = dernier relevé de price_historique&lt;br&gt;• product_category_id → alimente category_pivot et product_categorie&lt;br&gt;&lt;br&gt;&lt;b&gt;Sécurité (RLS Supabase)&lt;/b&gt;&lt;br&gt;• Catalogue : lecture publique · données perso : propriétaire seul&lt;br&gt;• user_guest / commandes_userguest : service_role uniquement" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;spacing=10;rounded=1;" vertex="1" parent="1"><mxGeometry x="3100" y="0" width="560" height="560" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>